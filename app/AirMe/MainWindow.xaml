<Window x:Class="AirMe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AirMe" Width="940" Height="650" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/airme.ico"
        Background="{StaticResource WindowBg}"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Ink}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Grid>
        <!-- ===================== INICIO ===================== -->
        <Grid x:Name="HomeView" Margin="30,20,30,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Barra superior -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Border x:Name="StatusPill" HorizontalAlignment="Left" VerticalAlignment="Center"
                        CornerRadius="20" Padding="14,8,18,8" Background="{StaticResource AccentSoft}">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="14" Height="14" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusHalo" Fill="#FFFFFF" Opacity="0.9"/>
                            <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource Accent}"/>
                        </Grid>
                        <TextBlock x:Name="StatusText" Text="Iniciando…" Margin="10,0,0,0" FontSize="15"
                                   FontWeight="SemiBold" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="HelpButton" Style="{StaticResource OutlineButton}" Click="Help_Click" Padding="14,9" AutomationProperties.Name="Ayuda">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE9CE;" FontSize="16"/>
                            <TextBlock x:Name="HelpButtonText" Text="¿No aparece AirMe?" Margin="9,0,0,0" FontSize="14"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource OutlineButton}" Click="Settings_Click" Margin="10,0,0,0"
                            Padding="10,9" ToolTip="Ajustes" AutomationProperties.Name="Ajustes">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Foreground="{StaticResource Ink}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Tarjetas -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Tarjeta izquierda: logo y estado -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <Grid Margin="28,24">
                        <StackPanel VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/Assets/logo.png" Height="230"
                                   RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,18"/>
                            <TextBlock x:Name="HeroTitle" Text="Listo para duplicar tu iPhone" FontFamily="{StaticResource DisplayFont}"
                                       FontSize="27" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock x:Name="HeroText" Margin="0,10,0,0" FontSize="15" LineHeight="23"
                                       Foreground="{StaticResource InkSoft}" TextAlignment="Center" TextWrapping="Wrap"
                                       Text="Tu PC ya aparece en la red como receptor AirPlay. Solo falta elegirlo desde el iPhone."/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Tarjeta derecha: cómo conectar / ayuda -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <Grid Margin="26,22,26,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Pasos -->
                        <StackPanel x:Name="StepsPanel" Grid.Row="0">
                            <TextBlock Text="Cómo conectar" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource AccentSoft}" VerticalAlignment="Top">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE701;" HorizontalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                    <TextBlock Text="Misma red WiFi" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="Conecta el iPhone y el PC a la misma red, sin VPN." FontSize="13.5"
                                               Foreground="{StaticResource InkSoft}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource AccentSoft}" VerticalAlignment="Top">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE9E9;" HorizontalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                    <TextBlock Text="Abre el Centro de Control" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="Desliza desde la esquina superior derecha y toca Duplicar pantalla." FontSize="13.5"
                                               Foreground="{StaticResource InkSoft}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource AccentSoft}" VerticalAlignment="Top">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xEC15;" HorizontalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                    <TextBlock x:Name="StepChooseTitle" Text="Elige AirMe" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="Aparece en la lista igual que un Apple TV." FontSize="13.5"
                                               Foreground="{StaticResource InkSoft}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Ayuda: ¿No aparece AirMe? -->
                        <StackPanel x:Name="HelpPanel" Grid.Row="0" Visibility="Collapsed">
                            <TextBlock Text="Si el iPhone no ve AirMe" FontSize="18" FontWeight="Bold" Margin="0,0,0,14"/>
                            <TextBlock FontSize="13.5" Foreground="{StaticResource InkSoft}" TextWrapping="Wrap" LineHeight="21">
                                <Run Text="1." FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                                <Run Text="iPhone y PC en la misma red. Sin VPN y sin la red de invitados del router (suele aislar los equipos)."/>
                            </TextBlock>
                            <TextBlock FontSize="13.5" Foreground="{StaticResource InkSoft}" TextWrapping="Wrap" LineHeight="21" Margin="0,8,0,0">
                                <Run Text="2." FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                                <Run Text="La red del PC debe ser Privada y el Firewall debe permitir AirMe (abajo puedes corregirlo)."/>
                            </TextBlock>
                            <TextBlock FontSize="13.5" Foreground="{StaticResource InkSoft}" TextWrapping="Wrap" LineHeight="21" Margin="0,8,0,0">
                                <Run Text="3." FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                                <Run Text="Si sigue sin aparecer, reinicia el receptor y vuelve a abrir Duplicar pantalla en el iPhone."/>
                            </TextBlock>
                            <Button Style="{StaticResource OutlineButton}" Click="RestartEngine_Click" HorizontalAlignment="Left"
                                    Margin="0,14,0,0" Content="Reiniciar receptor"/>
                        </StackPanel>

                        <!-- Estado del sistema -->
                        <StackPanel Grid.Row="1">
                            <Border Height="1" Background="{StaticResource Divider}" Margin="0,14,0,10"/>
                            <Grid Margin="0,4">
                                <TextBlock Text="Red" FontSize="14" Foreground="{StaticResource InkSoft}" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock x:Name="NetIcon" Style="{StaticResource Icon}" Text="&#xE930;" FontSize="16"/>
                                    <TextBlock x:Name="NetText" Text="Comprobando…" FontSize="14" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                    <Button x:Name="NetFix" Style="{StaticResource LinkButton}" Content="Cambiar" Margin="10,0,0,0"
                                            Click="NetFix_Click" Visibility="Collapsed" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,4">
                                <TextBlock Text="Firewall" FontSize="14" Foreground="{StaticResource InkSoft}" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock x:Name="FwIcon" Style="{StaticResource Icon}" Text="&#xE930;" FontSize="16"/>
                                    <TextBlock x:Name="FwText" Text="Comprobando…" FontSize="14" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                    <Button x:Name="FwFix" Style="{StaticResource LinkButton}" Content="Permitir" Margin="10,0,0,0"
                                            Click="FwFix_Click" Visibility="Collapsed" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,4">
                                <TextBlock Text="PIN de emparejamiento" FontSize="14" Foreground="{StaticResource InkSoft}" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock x:Name="PinText" Text="Desactivado" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Button x:Name="PinToggle" Style="{StaticResource LinkButton}" Content="Activar" Margin="10,0,0,0"
                                            Click="PinToggle_Click" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Pie -->
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <TextBlock Text="Motor de recepción: UxPlay · GPL-3.0" FontSize="13" Foreground="{StaticResource InkSoft}"/>
                <TextBlock Text="Atajo: Alt + Enter alterna pantalla completa" FontSize="13" Foreground="{StaticResource InkSoft}"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Grid>

        <!-- ===================== AJUSTES ===================== -->
        <ScrollViewer x:Name="SettingsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,20,40,24" MaxWidth="820">
                <Button Style="{StaticResource NavButton}" Click="Back_Click" HorizontalAlignment="Left" Margin="-4,0,0,6" AutomationProperties.Name="Volver al inicio">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE76B;" FontSize="14"/>
                        <TextBlock Text="Volver al inicio" Margin="10,0,0,0" FontSize="15" Foreground="{StaticResource Accent}"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="Ajustes" FontFamily="{StaticResource DisplayFont}" FontSize="32" FontWeight="Bold" Margin="0,6,0,18"/>

                <!-- Nombre -->
                <Border Style="{StaticResource Card}" CornerRadius="12" Padding="20,14" Margin="0,0,0,10">
                    <Grid>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,290,0">
                            <TextBlock Text="Nombre del receptor" FontSize="15.5" FontWeight="SemiBold"/>
                            <TextBlock Text="Así aparece AirMe en el Centro de Control del iPhone" FontSize="13.5"
                                       Foreground="{StaticResource InkSoft}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBox x:Name="NameBox" Style="{StaticResource TextField}" Width="270" HorizontalAlignment="Right"
                                 VerticalAlignment="Center" MaxLength="40" LostKeyboardFocus="NameBox_Commit" KeyDown="NameBox_KeyDown"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" CornerRadius="12" Padding="20,14" Margin="0,0,0,10">
                    <Grid>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,70,0">
                            <TextBlock Text="Iniciar con Windows" FontSize="15.5" FontWeight="SemiBold"/>
                            <TextBlock Text="AirMe queda listo en la bandeja del sistema" FontSize="13.5"
                                       Foreground="{StaticResource InkSoft}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="StartupSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Click="Switch_Click"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" CornerRadius="12" Padding="20,14" Margin="0,0,0,10">
                    <Grid>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,70,0">
                            <TextBlock Text="Minimizar a la bandeja al cerrar" FontSize="15.5" FontWeight="SemiBold"/>
                            <TextBlock Text="La ventana se oculta, pero AirMe sigue visible en la red" FontSize="13.5"
                                       Foreground="{StaticResource InkSoft}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="TraySwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Click="Switch_Click"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" CornerRadius="12" Padding="20,14" Margin="0,0,0,10">
                    <Grid>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,70,0">
                            <TextBlock Text="Pantalla completa al conectar" FontSize="15.5" FontWeight="SemiBold"/>
                            <TextBlock Text="Atajo en cualquier momento: Alt + Enter" FontSize="13.5"
                                       Foreground="{StaticResource InkSoft}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="FullscreenSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Click="Switch_Click"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" CornerRadius="12" Padding="20,14" Margin="0,0,0,10">
                    <Grid>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,70,0">
                            <TextBlock Text="Pedir PIN al conectar" FontSize="15.5" FontWeight="SemiBold"/>
                            <TextBlock x:Name="PinSettingText" Text="Código de 4 dígitos al conectar un iPhone nuevo" FontSize="13.5"
                                       Foreground="{StaticResource InkSoft}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="PinSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Click="Switch_Click"/>
                    </Grid>
                </Border>

                <TextBlock Margin="2,14,0,0" FontSize="13.5" Foreground="{StaticResource InkSoft}" TextWrapping="Wrap">
                    <Run Text="Motor de recepción: UxPlay (GPL-3.0)."/>
                    <Run x:Name="VersionRun" Text=""/>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
