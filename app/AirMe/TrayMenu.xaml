<Window x:Class="AirMe.TrayMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual" ShowActivated="True"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Ink}"
        UseLayoutRounding="True">
    <Border Margin="12" Background="#F8FAFE" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
            CornerRadius="14" Width="300">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.18" Color="#0B1B3F"/>
        </Border.Effect>
        <StackPanel Margin="10,14,10,10">
            <Grid Margin="10,0,10,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Image Source="pack://application:,,,/Assets/airme.ico" Width="32" Height="32"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="AirMe" FontSize="16" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{StaticResource Accent}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StateText" Text="Esperando conexión" Margin="7,0,0,0" FontSize="13"
                                   Foreground="{StaticResource InkSoft}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
            <Border Height="1" Background="{StaticResource Divider}" Margin="6,0,6,6"/>
            <Button Style="{StaticResource MenuItemButton}" Click="Open_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;"/>
                    <TextBlock Text="Abrir AirMe" Margin="14,0,0,0"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource MenuItemButton}" Click="Settings_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE713;"/>
                    <TextBlock Text="Ajustes" Margin="14,0,0,0"/>
                </StackPanel>
            </Button>
            <Border Height="1" Background="{StaticResource Divider}" Margin="6,6"/>
            <Button Style="{StaticResource MenuItemButton}" Click="Exit_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7E8;"/>
                    <TextBlock Text="Salir de AirMe" Margin="14,0,0,0"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Window>
